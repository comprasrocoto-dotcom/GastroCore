# ─────────────────────────────────────────────────────────────────────────────
# GastroCore — variables de entorno
# Tras cambiar cualquiera de estas en Vercel hay que hacer Redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Conmutador de backend (Fase 3) ───────────────────────────────────────────
# supabase   → la app lee y escribe en Supabase
# appsscript → la app sigue contra Google Sheets (valor por defecto)
#
# Se deja en appsscript a propósito: desplegar esta rama sin configurar nada
# NO debe cambiar de base de datos por accidente. Antes de ponerlo en supabase,
# corre `npm run verificar-esquema`.
GASTROCORE_BACKEND=appsscript

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pnotebuwhcuqapynjgrk.supabase.co
# Solo puede leer las dos vistas del recetario público (migración 0003).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salta RLS. SOLO en el servidor. Nunca al navegador, nunca a git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Marca activa (puente hasta la Fase 4) ────────────────────────────────────
# Slug de la marca que ve un usuario con sesión. Hoy es un valor fijo porque
# la cookie de sesión todavía no guarda marca; la Fase 4 lo reemplaza por el
# marca_id del usuario. Mientras esto siga aquí, la app es de UNA marca a la
# vez aunque la base ya soporte cuatro.
GASTROCORE_MARCA=rocoto

# ── Apps Script ──────────────────────────────────────────────────────────────
# Siguen siendo obligatorias aunque GASTROCORE_BACKEND=supabase: el login y el
# motor de analítica (getAnalytics, simularImpacto, generarSnapshot) todavía
# pasan por aquí. Ver PENDIENTE-FASE-3B en lib/api/supabase.ts.
GASTROCORE_API_URL=
GASTROCORE_API_TOKEN=

# ── Sesión propia ────────────────────────────────────────────────────────────
AUTH_SECRET=
